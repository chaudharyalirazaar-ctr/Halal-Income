# Copy this file to .env and fill in real values before running in production.

# Port the server listens on. The server also serves the website itself,
# so once running, visit http://localhost:PORT
PORT=3000

# Long random string used to sign session (JWT) cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Set to "production" when deploying for real (enables secure cookies, hides
# debug fields like the email verification code in API responses).
NODE_ENV=development

# Used only by `npm run seed:admin` to create/promote the first admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Powers the "Talk to AI assistant" widget on the FAQ page (backend/src/routes/assistant.js).
# Get a key at https://console.anthropic.com/settings/keys. Leave blank to disable the
# feature — the widget will show a "not configured" message instead of erroring.
ANTHROPIC_API_KEY=

# Powers real email delivery (verification codes, password reset links, and
# approval/rejection notifications) via https://resend.com (free tier: 100
# emails/day, no credit card). Leave blank and everything keeps working
# exactly as before — emails are just logged to the server console instead
# of actually sent.
RESEND_API_KEY=
# Must be an address on a domain you've verified with Resend, OR leave as
# the default below to send from Resend's shared testing domain (fine for
# development, not for real production use).
EMAIL_FROM=Halal Income <onboarding@resend.dev>
